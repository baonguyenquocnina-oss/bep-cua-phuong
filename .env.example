# Để trống sẽ chạy chế độ DEMO trên trình duyệt (dữ liệu lưu localStorage).
# Khi cấu hình Supabase, điền URL và anon key; xem README và schema.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Maps Embed/API key là tùy chọn. MVP hỗ trợ lấy tọa độ bằng trình duyệt
# và mở chỉ đường Google Maps không cần API key.
VITE_GOOGLE_MAPS_API_KEY=
